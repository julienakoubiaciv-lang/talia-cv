# Copier ce fichier en .env.local pour le développement local
# Ne JAMAIS committer .env.local (déjà dans .gitignore)

# ── Anthropic ─────────────────────────────────────────────────
# La clé Anthropic vit UNIQUEMENT côté serveur, dans les secrets de
# l'Edge Function Supabase `claude-proxy` (jamais dans le bundle client).
# À définir dans : Supabase → Project → Edge Functions → Secrets
#   ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=votre_anon_key_ici

# ── Vérification téléphone (OTP SMS) — activer plus tard ──────
VITE_REQUIRE_PHONE_VERIFICATION=false

# ── Relances encadrant → élève (Edge Function send-nudge) ─────
# Comme la clé Anthropic, ces secrets vivent UNIQUEMENT côté serveur.
# À définir dans : Supabase → Project → Edge Functions → Secrets
#   RESEND_API_KEY=re_...                        (resend.com — 3000 mails/mois offerts)
#   NUDGE_FROM=Altio <coach@votre-domaine.fr>    (expéditeur, domaine vérifié chez Resend)
#   APP_URL=https://app.votre-domaine.fr         (lien « Reprendre mon parcours » de l'email)
# Tant que RESEND_API_KEY et NUDGE_FROM ne sont pas définis, le bouton
# « Relancer » signale au conseiller que l'envoi n'est pas configuré, au lieu
# d'afficher un accusé d'envoi trompeur.
